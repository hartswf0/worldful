  "canonical_stones": [
    {
      "id": "daily_morning_refashioning",
      "stone": "Every morning Leonia wakes between fresh sheets, washes with just-unwrapped soap, wears brand-new clothing, takes unopened tins from the latest refrigerator, listening to latest-model radio jingles.",
      "elements": [
        "fresh_sheets",
        "unwrapped_soap",
        "brand_new_attire",
        "unopened_tins_fridge",
        "latest_model_radio"
      ]
    },
    {
      "id": "sacerdotal_street_cleaners",
      "stone": "On sidewalks wrapped in clean plastic bags, yesterday's Leonia (toothpaste tubes, burned-out lightbulbs, newspapers, containers, boilers, encyclopedias, grand pianos, porcelain services) awaits the garbage wagon; street cleaners are welcomed like angels in a silent, respectful rite of expelling recurrent impurity.",
      "elements": [
        "squeezed_toothpaste",
        "burned_lightbulbs",
        "yesterday_newspapers",
        "tin_containers_wrappings",
        "cast_iron_boilers",
        "bound_encyclopedias",
        "grand_pianos",
        "porcelain_services",
        "angelic_dustcarts"
      ]
    },
    {
      "id": "indestructible_crater_cuirass",
      "stone": "The more Leonia excels at making new materials, the more its rubbish resists time, elements, fermentations, and combustions (decompositionRate === 0), forming a stratified mountain-chain crater of indestructible leftovers soldered into an unremovable cuirass.",
      "elements": [
        "zero_decomposition_strata",
        "rollerskates",
        "soldered_past_scales",
        "rising_crater_ramparts"
      ]
    },
    {
      "id": "neighboring_rollers_and_cataclysm",
      "stone": "Beyond the ridges neighboring refashioning cities push inward rollers of flattened tin cans, burst old tires, frayed straw flasks, and mismatched old shoes until critical slope angle failure triggers a cataclysmic landslide effacing every trace of the metropolis dressed in new clothes.",
      "elements": [
        "flattened_tin_cans",
        "burst_old_tires",
        "unmated_old_shoes",
        "frayed_straw_flasks",
        "cataclysmic_avalanche"
      ]
    }
  ],
