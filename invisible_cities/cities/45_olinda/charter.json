      "number": 1,
      "label": "Magnifying Glass & Pinhead Nucleus",
      "text": "Go out into Olinda with a magnifying glass and seek carefully: somewhere a point no bigger than the head of a pin, slightly enlarged, reveals roofs, antennas, skylights, gardens, pools, streamers across streets, kiosks in squares, and a horse-racing track.",
      "pinhead_features": ["roofs", "antennas", "skylights", "gardens", "pools", "street_streamers", "square_kiosks", "horse_racing_track"]
    },
    {
      "id": "annual_concentric_meristem",
      "number": 2,
      "label": "Annual Concentric Meristem Expansion",
      "text": "The point does not stay still: after a year it is the size of half a lemon, then a large mushroom, then a soup plate, and finally a full-size city enclosed within the earlier city, pressing ahead inside it and pushing it toward the outside.",
      "scale_stages": ["pinhead", "half_lemon", "mushroom", "soup_plate", "full_city"]
    },
    {
      "id": "tree_ring_cambium_preservation",
      "number": 3,
      "label": "Tree-Ring Cambium Preservation",
      "text": "Olinda grows in concentric circles like a tree trunk adding one ring a year. Old walls expand carrying their quarters outward: towers, churches, palaces, theaters stretched thin into narrow outer girdles; at the innermost center a new pinhead Olinda is already blossoming.",
      "girdle_buildings": ["towers", "churches", "palaces", "theaters"]
    }
