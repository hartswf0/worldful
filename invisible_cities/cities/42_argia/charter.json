      "id": "earth_instead_of_air",
      "number": 1,
      "label": "Earth Instead of Air",
      "calvino_axiom": "What makes Argia different from other cities is that it has earth instead of air. The streets are completely filled with dirt, clay packs the rooms to the ceiling.",
      "causal_invariant": "airFraction === 0 && packedEarthFraction === 1.0"
    },
    {
      "id": "negative_stairways_and_rocky_skies",
      "number": 2,
      "label": "Negative Stairways & Rocky Cloud Strata",
      "calvino_axiom": "On every stairway another stairway is set in negative, over the roofs of the houses hang layers of rocky terrain like skies with clouds.",
      "causal_invariant": "negativeStairCount >= 5 && overburdenSky === 'rocky_terrain_clouds'"
    },
    {
      "id": "worm_tunnels_and_prone_stillness",
      "number": 3,
      "label": "Root Crevices, Worm Tunnels & Prone Stillness",
      "calvino_axiom": "Worm tunnels and crevices where roots twist pierce the black, damp crust; dampness destroys people's bodies and leaves scant strength, so everyone remains still, prone, in the dark.",
      "causal_invariant": "wormTunnelCount > 0 && rootCreviceCount > 0 && inhabitantPosture === 'still_and_prone'"
    },
    {
      "id": "barren_ground_and_night_door_slam",
      "number": 4,
      "label": "Deserted Stony Ground & Nocturnal Door Slam",
      "calvino_axiom": "From up above, nothing of Argia can be seen; the place is deserted. At night, putting your ear to the ground, you can sometimes hear a door slam.",
      "causal_invariant": "surfaceVisibility === 0 && (heardAtSurface === true implies earPressedAtNight === true)"
    }
  ],
  "invariants": {
    "airFraction": 0,
    "packedEarthFraction": 1.0,
    "surfaceVisibility": 0,
